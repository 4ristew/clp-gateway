## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ins.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Pp]ublish/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Aa][Rr][Mm][Uu][Pp]/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Local History for Visual Studio Code
.history/

# JetBrains Rider
.idea/
*.sln.iml

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Avalonia-specific or other .NET UI build artifacts
Generated\ Files/
AppPackages/
BundleArtifacts/

# NuGet Packages
*.nupkg
.nuget/
!/.nuget/NuGet.Config
!/.nuget/NuGet.targets
packages/

# Test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml

# ─── SmartGlue CLP Gateway ────────────────────────────────────────────────────

# Rastro de execucoes: e evidencia local da celula, nunca versionada
logs/
runs/
*.jsonl

# Configuracao da bancada e da cabine: carrega o segredo do JWT e o host do CLP
appsettings.Local.json
appsettings.*.local.json
secrets.json

# Saida do scripts/publish.ps1
artifacts/
