{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "//": "JwtSettings:Secret is NOT stored here. It is the same symmetric key smt_glue signs with, so it belongs in User Secrets (dev) or appsettings.Local.json (cabin PC), never in the repository.",
  "JwtSettings": {
    "Issuer": "AuthentifierProviderAPI",
    "Audience": "AuthentifierProviderClients"
  },

  "Backend": {
    "BaseUrl": "http://127.0.0.1:5113/api/",
    "TimeoutSeconds": 15
  },

  "AxisHardware": {
    "Enabled": true,
    "Host": "127.0.0.1",
    "ModbusPort": 5020,
    "UnitId": 1,
    "PulsesPerMillimeter": 1000,
    "DefaultSpeedPulsesPerSecond": 20000,
    "ConnectRetryAttempts": 3,
    "ConnectRetryDelaySeconds": 5,
    "HeartbeatIntervalMs": 200,
    "HeartbeatTimeoutMs": 1000,
    "ModbusTransactionTimeoutMs": 400,
    "CommandPollIntervalMs": 50,
    "CommandTimeoutSeconds": 30,
    "HomeTimeoutSeconds": 90,
    "HomeCompletion": "Done",
    "RefusalGraceMs": 500,
    "PositionTolerancePulses": 2,
    "InspectionRequiresReferencedZ": true,
    "LimitsCacheMaxAgeSeconds": 300,
    "ClearHeartbeatLostOnSessionOpen": true
  },

  "Vision": {
    "Enabled": true,
    "BaseUrl": "http://127.0.0.1:8080",
    "Station": "inspection",
    "TimeoutSeconds": 10,
    "FetchRetryAttempts": 3,
    "FetchRetryDelaySeconds": 5,
    "FieldWidthPulses": 20000,
    "FieldHeightPulses": 15000,
    "OutputWidthPixels": 640,
    "OutputHeightPixels": 480
  },

  "Results": {
    "Enabled": true,
    "Directory": "logs/runs"
  }
}
